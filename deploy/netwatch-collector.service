# 采集端(root):ss 轮询采集 + 落库 + 规则/基线告警;不开任何网络端口
# 本文件含 @占位@,由 deploy/install.sh 渲染后装入 /etc/systemd/system/(勿直接 cp)
# 手动安装需替换:@REPO_DIR@ 仓库路径;@NODE_BIN@ node 可执行(nvm 用 `command -v node` 确认)
[Unit]
Description=netwatch collector - 进程级上传采集(root)
Documentation=https://github.com/Ytadpole/netwatch
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=@REPO_DIR@
ExecStart=@NODE_BIN@ --import tsx apps/collector/src/cli.ts
Restart=always
RestartSec=5
# 共享状态:库与规则文件放 /var/lib/netwatch,与展示端(User=普通用户)通过 SQLite 文件耦合
# UMask=0000 → db/-wal/-shm 为 666,展示端只读连接可读(展示端 After=本服务,-shm 已存在)
Environment=NETWATCH_DB=/var/lib/netwatch/netwatch.db
Environment=NETWATCH_RULES=/var/lib/netwatch/rules.json
UMask=0000
# 日志进 journald:journalctl -u netwatch-collector -f
StandardOutput=journal
StandardError=journal
# 告警桌面通知在无图形会话下自动跳过,无需配置 DISPLAY

[Install]
WantedBy=multi-user.target
